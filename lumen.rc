#define IDR_DIAL_LIGHT 201
#define IDR_DIAL_DARK  202

1 ICON "lumen.ico"

1 VERSIONINFO
FILEVERSION 1,5,0,0
PRODUCTVERSION 1,5,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "FileDescription", "lumen"
      VALUE "ProductName", "lumen"
      VALUE "FileVersion", "1.5.0"
      VALUE "OriginalFilename", "lumen.exe"
      VALUE "LegalCopyright", "MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END

// 预烘焙 3D 旋钮底图（静态层，运行时按 DPI 缩放）
IDR_DIAL_LIGHT RCDATA "assets/dial_light.png"
IDR_DIAL_DARK  RCDATA "assets/dial_dark.png"
